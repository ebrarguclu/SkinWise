# ---------- Dependencies ----------
node_modules/

# ---------- Environment variables / secrets ----------
# Ignore every .env and .env.* file in any folder...
.env
.env.*
# ...but keep example files tracked (e.g. backend/.env.example)
!.env.example

# ---------- Build output ----------
dist/
build/

# ---------- Test coverage ----------
coverage/
.nyc_output/

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- OS files ----------
.DS_Store
Thumbs.db

# ---------- Editor files ----------
# Ignore everything in .vscode except the shared team settings
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/extensions.json
.idea/
